# Copiar a .env y completar con valores reales. NUNCA subir .env al repositorio.
# Ubicación de datos privados (BD, rostros, modelo LBPH, backups). En la Pi usa esta ruta:
PROYECTO_C3_DATA=/home/saffu1/.local/share/proyectoC3
# En desarrollo en otra máquina puedes dejar unset y usará ./data (ignorado por git).

DEVICE_NAME=raspberry-pi-5
CAMERA_INDEX=0
CAPTURE_WIDTH=640
CAPTURE_HEIGHT=480
CAPTURE_SIZE=320

# --- Flask ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET=CHANGE_ME_RANDOM_VALUE
# Orígenes CORS del panel web (Vite en dev)
CORS_ORIGINS=http://localhost:5173

# --- Administrador local (procedimiento de inicialización seguro, ver docs/authorization-guide.md) ---
# La primera cuenta NO se crea por API: se crea con `python -m device.cli init-admin`.
ADMIN_USERNAME=admin
ADMIN_FULLNAME=Administrador
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Reconocimiento ---
# Distancia LBPH máxima para aceptar una coincidencia. Calibrar con imágenes reales
# (ver docs/authorization-guide.md). NO es una probabilidad: es distancia del modelo.
LBPH_THRESHOLD=55

# --- Sincronización con Supabase (opcional) ---
SYNC_ENABLED=false
SYNC_INTERVAL_SECONDS=60
# Antigüedad máxima de la copia local de políticas antes de denegar decisiones privilegiadas
POLICY_MAX_AGE_HOURS=72
SUPABASE_URL=
# Nunca usar la clave service_role en el frontend React. Solo aquí, en el dispositivo.
SUPABASE_SERVICE_ROLE_KEY=
